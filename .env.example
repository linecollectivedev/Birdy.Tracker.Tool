# Configure these as server-side environment variables in Vercel.
# Use a separate database and secrets for Development/Preview.
DATABASE_URL=postgresql://TEST_USER:TEST_PASSWORD@TEST_HOST/TEST_DATABASE?sslmode=require
SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Used only to create the first PM when tracker_users is empty.
BOOTSTRAP_PM_USERNAME=project.manager
BOOTSTRAP_PM_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_AT_LEAST_12_CHARACTERS

# Remove BOOTSTRAP_PM_PASSWORD after the first PM account is created.
